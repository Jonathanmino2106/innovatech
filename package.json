{
  "name": "innovatech",
  "version": "1.0.0",
  "description": "PASAPORTE.26 | Feria Tecnológica",
  "private": true,
  "scripts": {
    "css": "tailwindcss -i ./src/css/tailwind.css -o ./src/css/tailwind.generated.css --minify",
    "css:watch": "tailwindcss -i ./src/css/tailwind.css -o ./src/css/tailwind.generated.css --watch",
    "qr:cromos": "node tools/generar-qr-cromos.js",
    "build": "node build.js && npm run css",
    "start": "npm run build && node server.js",
    "dev": "node build.js && npm run css && node server.js"
  },
  "dependencies": {
    "@supabase/server": "^1.9.1"
  },
  "devDependencies": {
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.17"
  }
}

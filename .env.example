# ============================================================
# INNOVATECH - PASAPORTE.26
# Copiá este archivo a `.env` (en la raíz del proyecto):
#
#     cp .env.example .env        (Linux / macOS)
#     copy .env.example .env      (Windows)
#
# El archivo `.env` está en .gitignore: NUNCA se sube a GitHub.
# Lo consume `build.js` para generar `src/js/config.js`.
#
# ¿De dónde saco los valores?
#   Supabase → tu proyecto → Settings → API
#     • Project URL          → SUPABASE_URL
#     • anon / public key    → SUPABASE_ANON_KEY
# ============================================================

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_TU_CLAVE_AQUI
